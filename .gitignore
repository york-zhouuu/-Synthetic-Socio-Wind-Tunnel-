# Map enrichment snapshots — timestamped raw pulls are big and regeneratable;
# the "latest" aliases (data/overture_buildings.geojson, data/overture_places.geojson)
# and the merged product (data/lanecove_enriched.geojson) are NOT ignored and
# should be committed so that pipeline is reproducible without re-pulling.
data/sources/

# Local AI / tooling caches
.claude/

# Fitness-audit report - regenerated by `make fitness-audit`, not committed
# (snapshot-of-basic-fitness belongs to a point in time, not to source)
data/fitness-report.json

# Multi-day experiment runs - produced by tools/run_multi_day_experiment.py
# per-seed JSON + aggregate; point-in-time artifacts, not source
data/runs/

# Variant-suite experiments - produced by tools/run_variant_suite.py
# per-variant × per-seed × contest + report scaffold; point-in-time
data/experiments/

# Setup-content cache (setup-content-cache, 2026-05-16)
# Per-seed life_history + identity_text generated by
# tools/prewarm_setup_content.py — deterministic from seed but expensive
# to regenerate; each machine prewarms its own.
data/setup_content_cache/

# Legacy life-history-only cache (predecessor to setup_content_cache)
data/life_history_cache/

# Population cache (backlog 1.7 H, 2026-05-20): per-seed sample_population
# output cache. Deterministic from inputs but ~10-20s/spawn to regenerate;
# each machine maintains its own.
data/population_cache/

# runtime-instrumentation (2026-05-20): stray JSONL files at repo
# root if a test or ad-hoc script defaults INSTRUMENTATION_OUTPUT_DIR=.
seed_*.memstat.jsonl
seed_*.events.jsonl
seed_*.llm.jsonl
