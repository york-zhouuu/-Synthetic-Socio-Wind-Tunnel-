# Copy to `.env` and fill in your key. .env is gitignored — never commit.
#
# Any one of these is enough; pick the provider you have an account for:
#   - GEMINI_API_KEY    → Gemini Flash (cheap, default for --use-real-llm)
#   - ANTHROPIC_API_KEY → Claude Haiku/Sonnet
#   - DEEPSEEK_API_KEY  → DeepSeek v4-pro / v4-flash (high RPM, low $)
#
# Get a key:
#   - Gemini:    https://aistudio.google.com/app/apikey
#   - Anthropic: https://console.anthropic.com/settings/keys
#   - DeepSeek:  https://platform.deepseek.com/api_keys

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
