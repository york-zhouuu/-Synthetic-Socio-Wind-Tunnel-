# Copy to `.env` and fill in your key. .env is gitignored — never commit.
#
# Any one of these is enough; pick the provider you have an account for:
#   - GEMINI_API_KEY      → Gemini Flash / Flash Lite (cheap, current default)
#   - ANTHROPIC_API_KEY   → Claude Haiku/Sonnet
#   - DEEPSEEK_API_KEY    → DeepSeek v4-pro / v4-flash (high RPM, low $)
#   - DEEPSEEK_API_KEYS   → multi-key round-robin (comma-separated),
#                           overrides DEEPSEEK_API_KEY when set
#
# Get a key:
#   - Gemini:    https://aistudio.google.com/app/apikey
#   - Anthropic: https://console.anthropic.com/settings/keys
#   - DeepSeek:  https://platform.deepseek.com/api_keys

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Multi-key rotation (optional, recommended for large publishable runs).
# Comma-separated keys. Each call round-robins across keys for 2x+ effective
# rate-limit headroom. The matching single-key env var is used as fallback.
DEEPSEEK_API_KEYS=
# GEMINI_API_KEYS=key1,key2  (added 2026-05-15 run-resilience)

# Sensitivity sweep (optional). Default 0.3 — used in B3 sensitivity check.
# SSWT_BASE_NOTICING_RATE=0.3

# ---------------------------------------------------------------------------
# run-resilience (D1' 2026-05-15 fix) — all RESILIENCE_* are optional.
# Defaults shown. Override only if you understand the trade-offs.
# ---------------------------------------------------------------------------
# Retry policy (shared by Gemini / DeepSeek / Anthropic tier clients)
# RESILIENCE_RETRY_MAX_ATTEMPTS=3
# RESILIENCE_RETRY_BASE_BACKOFF=0.5
# RESILIENCE_RETRY_MAX_BACKOFF=8.0
# RESILIENCE_RETRY_JITTER_RATIO=0.2

# HTTP pool config — DO NOT raise max_keepalive above 0 for publishable runs.
# keepalive=0 is what blocks the D1' Gemini CLOSE_WAIT deadlock.
# RESILIENCE_POOL_MAX_CONNECTIONS=600
# RESILIENCE_POOL_MAX_KEEPALIVE=0
# RESILIENCE_POOL_CONNECT_TIMEOUT=10.0
# RESILIENCE_POOL_READ_TIMEOUT=45.0
# RESILIENCE_POOL_WRITE_TIMEOUT=10.0
# RESILIENCE_POOL_TIMEOUT=30.0
# RESILIENCE_RECYCLE_AFTER_CALLS=1000

# Per-key circuit breaker
# RESILIENCE_CIRCUIT_FAILURE_THRESHOLD=5
# RESILIENCE_CIRCUIT_COOLDOWN=300

# audit_run_health.py / HealthAudit thresholds
# RESILIENCE_HEALTH_SILENT_WARN_SECONDS=1800
# RESILIENCE_HEALTH_SILENT_DEADLOCK_SECONDS=3600
# RESILIENCE_HEALTH_CLOSE_WAIT_WARN_RATIO=0.6
# RESILIENCE_HEALTH_CLOSE_WAIT_DEADLOCK_RATIO=0.9

# Emergency escape hatch — skips run-resilience hardening, falls back to the
# pre-2026-05-15 SDK defaults. Use only for in-flight runs that can't be
# restarted (D2 was the original instance). NEVER set for fresh publishable runs.
# RESILIENCE_DISABLE=1

# ---------------------------------------------------------------------------
# tick-level-resume (2026-05-16) — per-tick WAL + per-N-tick snapshot
# ---------------------------------------------------------------------------
# Snapshot frequency (every N global ticks). 0 = disable; max 288 = per day.
# Default 24 = hourly snapshots in a 5-min tick model. Lower = less data
# loss on crash but more disk + I/O overhead.
# RESILIENCE_SNAPSHOT_EVERY_TICKS=24

# Snapshot rolling-keep count. K=2 keeps last 2 snapshots (covers ≥ 1 day).
# RESILIENCE_SNAPSHOT_KEEP_LAST=2

# Per-tick WAL writer. Cost is ~400 KB/seed for 14d; turn off only for dev.
# RESILIENCE_WAL_ENABLED=true

# WAL fsync frequency. 1 = fsync every tick (safest, ~2-10ms each).
# Higher values trade durability for speed.
# RESILIENCE_WAL_FSYNC_EVERY_TICKS=1

# Health audit: expected wall-clock seconds per tick (used to flag suspected_stuck
# when the latest WAL line is too old). 5s ~= 1000-agent × DeepSeek empirical avg.
# RESILIENCE_HEALTH_TICK_SECONDS_EXPECTED=5
# RESILIENCE_HEALTH_STUCK_WARN_FACTOR=10
# RESILIENCE_HEALTH_STUCK_DEADLOCK_FACTOR=30
