# Copy to `.env` and fill in your key. .env is gitignored — never commit.
#
# Any one of these is enough; pick the provider you have an account for:
#   - GEMINI_API_KEY      → Gemini Flash / Flash Lite (cheap, current default)
#   - ANTHROPIC_API_KEY   → Claude Haiku/Sonnet
#   - DEEPSEEK_API_KEY    → DeepSeek v4-pro / v4-flash (high RPM, low $)
#   - DEEPSEEK_API_KEYS   → multi-key round-robin (comma-separated),
#                           overrides DEEPSEEK_API_KEY when set
#
# Get a key:
#   - Gemini:    https://aistudio.google.com/app/apikey
#   - Anthropic: https://console.anthropic.com/settings/keys
#   - DeepSeek:  https://platform.deepseek.com/api_keys

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Multi-key rotation (optional, recommended for large publishable runs).
# Comma-separated DeepSeek keys. Each call round-robins across keys for 2x+
# effective rate-limit headroom. Tier client reads this first; falls back to
# DEEPSEEK_API_KEY (single) if unset.
DEEPSEEK_API_KEYS=

# Sensitivity sweep (optional). Default 0.3 — used in B3 sensitivity check.
# SSWT_BASE_NOTICING_RATE=0.3
